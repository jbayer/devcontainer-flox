{
  "name": "Dev Container Example",
  "image": "jbayer/devcontainer-flox:1.12.1@sha256:821cc5b7e9d0befbb97b83ccc4795889326a035a6c316c792fe748de10ad5212",
  "features": {
      },
  "customizations": {
    "vscode": {
      "extensions": [
        "flox.flox",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=${localEnv:HOME}/.ssh,type=bind,readonly",
    "source=devcontainer-nix-store,target=/nix,type=volume",
    "source=${localWorkspaceFolderBasename}-flox-home,target=/home/flox,type=volume"
  ],
  "postStartCommand": "",
  "remoteUser": "flox"
}
